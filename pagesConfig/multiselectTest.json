{
  "reportName": "Multiselect Test",
  "filterLayout": "sidebar",
  "filters": [
    {
      "id": "region",
      "label": "Region",
      "type": "multiselect",
      "scope": "global",
      "options": [
        { "label": "North", "value": "north" },
        { "label": "South", "value": "south" },
        { "label": "East", "value": "east" },
        { "label": "West", "value": "west" },
        { "label": "Central", "value": "central" }
      ]
    },
    {
      "id": "fin",
      "label": "FIN",
      "type": "string",
      "scope": "global"
    }
  ],
  "tabs": [
    {
      "trigger": "Overview",
      "rows": [
        {
          "height": 80,
          "components": [
            {
              "moduleName": "LineChartModule",
              "space": 0,
              "chartTitle": "Regionale Aktivität über die Zeit",
              "chartDescription": "Mock data demonstrating the multiselect filter control.",
              "chartID": "multiselect-demo-line",
              "filterBindings": {
                "region": "region",
                "fin": "fin"
              },
              "mockData": [
                { "x": 1, "y": [12] },
                { "x": 2, "y": [18] },
                { "x": 3, "y": [9] },
                { "x": 4, "y": [24] },
                { "x": 5, "y": [15] },
                { "x": 6, "y": [30] }
              ],
              "chartConfig": {
                "xAxis": {
                  "show": true,
                  "tickLine": true,
                  "axisLine": true,
                  "tickMargin": 5,
                  "format": "number"
                },
                "yAxis": {
                  "show": true,
                  "tickLine": true,
                  "axisLine": true,
                  "format": "number"
                },
                "grid": {
                  "show": true,
                  "horizontal": true,
                  "vertical": false,
                  "strokeDasharray": "3 3"
                },
                "tooltip": {
                  "show": true,
                  "cursor": true
                },
                "legend": {
                  "show": true
                },
                "margin": {
                  "top": 20,
                  "right": 30,
                  "bottom": 20,
                  "left": 60
                },
                "lines": [
                  {
                    "seriesIndex": 0,
                    "name": "Einträge",
                    "curve": "monotone",
                    "stroke": "var(--chart-1)",
                    "strokeWidth": 2,
                    "connectNulls": true,
                    "dots": {
                      "show": true,
                      "radius": 4,
                      "fill": "var(--chart-1)",
                      "stroke": "#fff",
                      "strokeWidth": 2
                    },
                    "activeDot": {
                      "show": true,
                      "radius": 6,
                      "fill": "var(--chart-1)",
                      "stroke": "#fff",
                      "strokeWidth": 2
                    },
                    "fill": {
                      "enabled": true,
                      "color": "var(--chart-1)",
                      "opacity": 0.1
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
